# Copy this file to .env and replace every placeholder with a real value.
# This file is safe to commit; .env is ignored.
QUANTUMWALK_ENV=development
# Use localhost for both the browser and OAuth callback so the state cookie is shared.
FRONTEND_ORIGIN=http://localhost:3000
# Leave unset for local SQLite (api/quantumwalk-dev.db). Set only when Postgres is reachable.
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@your-host:5432/postgres?sslmode=require
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match Google Cloud Console exactly (Authorized redirect URIs):
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Optional remote AI tutor. Keep this server-side; never put it in web/.env.local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_STYLE=responses

# SRS subscriptions: server-side only. Leave empty until a test provider is configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
QUANTUMWALK_PAID_PLANS=[]
# Verified Google provider subjects allowed to bootstrap platform administration.
QUANTUMWALK_ADMIN_GOOGLE_SUBJECTS=

# Verified email identity. STARTTLS delivery is required.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
