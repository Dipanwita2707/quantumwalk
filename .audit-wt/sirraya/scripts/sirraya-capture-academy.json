{
  "browser": {
    "mode": "launch",
    "executable_path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
    "headless": true
  },
  "start_url": { "url": "https://tools.sirraya.org/" },
  "capture": {
    "after_each_step": ["accessibility", "url"],
    "at_end": ["accessibility", "screenshot"],
    "events": ["network", "console", "page-errors"],
    "network": { "request_body": false, "response_body": true, "header_values": false }
  },
  "actions": [
    {
      "step_id": "hub-ready",
      "action": "wait_for",
      "timeout_ms": 60000,
      "locator": { "kind": "role", "role": "button", "name": "Create a document" },
      "state": "visible"
    },
    {
      "step_id": "open-command-menu",
      "action": "click",
      "timeout_ms": 20000,
      "locator": { "kind": "role", "role": "button", "name": "Open command menu" }
    },
    { "step_id": "menu-wait", "action": "wait_for_timeout", "duration_ms": 1500 },
    {
      "step_id": "type-academy",
      "action": "fill",
      "timeout_ms": 15000,
      "locator": { "kind": "role", "role": "textbox", "name": "Search tools and actions" },
      "value": { "source": "literal", "value": "Quantum Academy" }
    },
    {
      "step_id": "submit-academy",
      "action": "press",
      "timeout_ms": 15000,
      "locator": { "kind": "role", "role": "textbox", "name": "Search tools and actions" },
      "key": "Enter"
    },
    { "step_id": "settle", "action": "wait_for_timeout", "duration_ms": 18000 }
  ]
}
