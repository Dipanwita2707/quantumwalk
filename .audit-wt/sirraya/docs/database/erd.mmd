erDiagram
  USER ||--o{ USER_SESSION : has
  USER ||--o{ CIRCUIT : owns
  USER ||--o{ PROGRESS : tracks
  USER ||--o{ HUB_DOCUMENT : owns
  HUB_DOCUMENT ||--o{ HUB_DOCUMENT_REVISION : versions

  USER {
    uuid id PK
    string email
    string google_sub
  }
  HUB_DOCUMENT {
    uuid id PK
    uuid user_id FK
    string title
    string kind
    timestamptz updated_at
  }
  HUB_DOCUMENT_REVISION {
    uuid id PK
    uuid document_id FK
    int revision_no
    text body_md
    timestamptz created_at
  }
