{
  "browser": {
    "mode": "launch",
    "executable_path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
    "headless": true
  },
  "start_url": { "url": "https://tools.sirraya.org/" },
  "capture": {
    "after_each_step": ["accessibility", "url"],
    "events": ["network", "console", "page-errors"],
    "network": {
      "request_body": false,
      "response_body": false,
      "header_values": false
    }
  },
  "actions": [
    {
      "step_id": "hub-ready",
      "action": "wait_for",
      "timeout_ms": 60000,
      "locator": { "kind": "role", "role": "button", "name": "Create a document" },
      "state": "visible"
    },
    {
      "step_id": "open-explorer",
      "action": "click",
      "timeout_ms": 60000,
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Experimental Quantum Explorer Experimental platform for quantum algorithm testing and Traveling Salesman Problem solutions. Research"
      }
    },
    {
      "step_id": "explorer-ready",
      "action": "wait_for",
      "timeout_ms": 60000,
      "locator": { "kind": "role", "role": "button", "name": "Check Status" },
      "state": "visible"
    },
    { "step_id": "explorer-wait", "action": "wait_for_timeout", "duration_ms": 3000 },
    {
      "step_id": "click-check-status",
      "action": "click",
      "timeout_ms": 20000,
      "locator": { "kind": "role", "role": "button", "name": "Check Status" }
    },
    { "step_id": "after-check", "action": "wait_for_timeout", "duration_ms": 5000 }
  ]
}
